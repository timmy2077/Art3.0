  m_Script: {fileID: 11500000, guid: 8cc3d72b64075c14387a587d7b905c3e, type: 3}
  m_Name: Chef0
  m_EditorClassIdentifier: 
  historyId: cc7d697d0655c61408e86372d902b263
  npcName: "\u5E96\u957F"
  isCoreNPC: 1
  endAfterScience: 1
  greetingLines:
  - "\u540E\u53A8\u63A5\u8FDE\u906D\u9047\u53D8\u6545\uFF0C\u5BB4\u5E2D\u7684\u5668\u5177\u6563\u843D\u5404\u5904\uFF0C\u7076\u53F0\u4E5F\u88AB\u5835\u6B7B\u3002"
  - "\u5BBE\u5BA2\u8FD8\u5728\u5385\u5802\u7B49\u5019\uFF0C\u5B9E\u5728\u4EE4\u4EBA\u7126\u6025\u3002"
  taskChoiceText: "\u6211\u6765\u5E2E\u5FD9\u6574\u7406\u5907\u9910"
  taskLines:
  - "\u591A\u8C22\u4F60\u7684\u63F4\u624B\uFF01\u9676\u8033\u676F\u3001\u98DF\u76D8\u3001\u70E4\u8089\u7089\u8FD9\u4E9B\u5BB4\u996E\u5668\u5177\u6563\u843D\u5728\u540E\u53A8\u5404\u4E2A\u89D2\u843D\u3002"
  - "\u8FD8\u8BF7\u4F60\u9010\u4E00\u627E\u5BFB\u6536\u96C6\uFF0C\u627E\u9F50\u540E\u56DE\u6765\u544A\u8BC9\u6211\u3002"
  scienceChoiceText: "\u9B4F\u664B\u7684\u5BB4\u5E2D\u6709\u54EA\u4E9B\u4E60\u4FD7\uFF1F"
  scienceLines:
  - "\u6211\u4EEC\u8FD9\u4E00\u5E26\u76DB\u884C\u5206\u9910\u5236\uFF0C\u6BCF\u4F4D\u5BBE\u5BA2\u90FD\u4F1A\u5355\u72EC\u914D\u5907\u6848\u51E0\u4E0E\u98DF\u5668\uFF0C\u4E0D\u4F1A\u591A\u4EBA\u5171\u7528\u4E00\u684C\u996E\u98DF\u3002"
  - "\u6CB3\u897F\u5730\u533A\u519C\u7267\u517C\u5177\uFF0C\u5BB4\u5E2D\u4E4B\u4E0A\u65E2\u6709\u9762\u98DF\u3001\u8C37\u7269\uFF0C\u4E5F\u6709\u65B0\u9C9C\u8089\u98DF\uFF0C\u996E\u98DF\u79CD\u7C7B\u5341\u5206\u4E30\u5BCC\u3002"
  - "\u5893\u846C\u4E4B\u4E2D\u7ED8\u5236\u5E96\u53A8\u4E0E\u5BB4\u996E\u753B\u9762\uFF0C\u662F\u53E4\u4EBA\u7684\u7F8E\u597D\u671F\u8BB8\uFF0C\u5E0C\u671B\u79BB\u4E16\u4E4B\u540E\uFF0C\u4F9D\u65E7\u80FD\u4EAB\u7528\u7F8E\u98DF\u3001\u6B22\u805A\u4E00\u5802\u3002"
  - "\u4E86\u89E3\u5B8C\u8FD9\u4E9B\u98CE\u4FD7\uFF0C\u82E5\u662F\u6709\u7A7A\uFF0C\u8FD8\u8BF7\u5E2E\u6211\u4EEC\u4E00\u540C\u5B8C\u6210\u5907\u9910\u5DE5\u4F5C\u3002"
  minorNPCLines:
  - "\u6625\u65E5\u6851\u53F6\u9C9C\u5AE9\uFF0C\u6B63\u662F\u91C7\u6458\u517B\u8695\u7684\u597D\u65F6\u8282\u3002"
  - "\u9B4F\u664B\u65F6\u671F\u4E1D\u7EF8\u8D38\u6613\u5341\u5206\u7E41\u76DB\uFF0C\u6CB3\u897F\u4EA7\u51FA\u7684\u4E1D\u7EF8\u8FDC\u9500\u5404\u5730\u3002"
