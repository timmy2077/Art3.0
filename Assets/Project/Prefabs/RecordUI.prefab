  bricks:
  - id: gengzhong
    displayName: "\u8015\u79CD\u56FE"
    sprite: {fileID: -928170939, guid: eb4e8f86ad1c8af458e648e4cc5171fd, type: 3}
    detailSprite: {fileID: 0}
    imageCaption: "\u6E38\u620F\u590D\u539F\u56FE \xB7 \u4F9D\u636E\u753B\u50CF\u7816\u9898\u6750\u6539\u7F16"
    era: "\u9B4F\u664B\u65F6\u671F\uFF08\u9898\u6750\u5E74\u4EE3\uFF09"
    excavationSite: "\u5177\u4F53\u539F\u7816\u51FA\u571F\u4FE1\u606F\u5F85\u8003\u8BC1"
    currentCollection: "\u5F85\u8003\u8BC1"
    interpretation: "\u753B\u9762\u56F4\u7ED5\u725B\u3001\u7281\u4E0E\u8015\u4F5C\u8005\u5C55\u5F00\uFF0C\u5C06\u4EBA\u7269\u52A8\u4F5C\u548C\u519C\u5177\u7EC4\u7EC7\u4E3A\u8FDE\u7EED\u7684\u52B3\u4F5C\u573A\u666F\u3002\u89C2\u5BDF\u725B\u4E0E\u7281\u7684\u8FDE\u63A5\u3001\u4EBA\u7269\u7684\u59FF\u6001\uFF0C\u53EF\u4EE5\u7406\u89E3\u7816\u753B\u5982\u4F55\u7528\u7B80\u7EC3\u7684\u7EBF\u6761\u8868\u73B0\u751F\u4EA7\u6D3B\u52A8\u3002\n\n\u672C\u4F5C\u4EE5\u8FD9\u4E00\u9898\u6750\u6784\u5EFA\u519C\u8015\u751F\u6D3B\u7684\u60F3\u8C61\u3002\u753B\u4E2D\u5177\u4F53\u519C\u5177\u540D\u79F0\u3001\u8015\u4F5C\u65B9\u5F0F\u53CA\u5176\u5386\u53F2\u89E3\u91CA\uFF0C\u4ECD\u9700\u7ED3\u5408\u5BF9\u5E94\u539F\u7816\u4E0E\u8003\u53E4\u8D44\u6599\u6838\u5BF9\u3002"
    sources: "\u9898\u6750\u4F9D\u636E\uFF1A\u672C\u4F5C\u300A\u5C18\u5C01\u7816\u8BED\u300B\u8BBE\u8BA1\u65B9\u6848\u53CA\u5F00\u9898\u62A5\u544A\u4E2D\u7684\u6CB3\u897F\u9B4F\u664B\u753B\u50CF\u7816\u9009\u9898\u3002\n\n\u5F53\u524D\u5C55\u793A\u4E3A\u6E38\u620F\u590D\u539F\u56FE\u3002\u5BF9\u5E94\u6587\u7269\u7684\u7F16\u53F7\u3001\u6B63\u5F0F\u56FE\u5F55\u9875\u7801\u4E0E\u9986\u85CF\u8D44\u6599\u5C1A\u5F85\u6838\u9A8C\uFF0C\u5177\u4F53\u5E74\u4EE3\u3001\u51FA\u571F\u5730\u548C\u73B0\u85CF\u5730\u4EE5\u6B63\u5F0F\u8D44\u6599\u4E3A\u51C6\u3002"
  - id: paochu
    displayName: "\u5E96\u53A8\u56FE"
    sprite: {fileID: -1056584777, guid: 98a6beb877d24f842b83739cc6f1676a, type: 3}
    detailSprite: {fileID: 0}
    imageCaption: "\u6E38\u620F\u590D\u539F\u56FE \xB7 \u4F9D\u636E\u753B\u50CF\u7816\u9898\u6750\u6539\u7F16"
    era: "\u9B4F\u664B\u65F6\u671F\uFF08\u9898\u6750\u5E74\u4EE3\uFF09"
    excavationSite: "\u5177\u4F53\u539F\u7816\u51FA\u571F\u4FE1\u606F\u5F85\u8003\u8BC1"
    currentCollection: "\u5F85\u8003\u8BC1"
    interpretation: "\u5E96\u53A8\u9898\u6750\u63CF\u7ED8\u98DF\u6750\u5904\u7406\u3001\u70F9\u996A\u4E0E\u5907\u9910\u7B49\u751F\u6D3B\u6D3B\u52A8\u3002\u4EBA\u7269\u7684\u624B\u52BF\u3001\u5668\u5177\u7684\u6446\u653E\u548C\u52A8\u4F5C\u4E4B\u95F4\u7684\u8054\u7CFB\uFF0C\u5171\u540C\u6784\u6210\u4E00\u5E45\u65E5\u5E38\u52B3\u4F5C\u56FE\u666F\u3002\n\n\u672C\u4F5C\u501F\u6B64\u5448\u73B0\u996E\u98DF\u751F\u6D3B\u3002\u5177\u4F53\u98DF\u6750\u3001\u5668\u7269\u540D\u79F0\u548C\u793C\u4EEA\u542B\u4E49\uFF0C\u9700\u8981\u7ED3\u5408\u5BF9\u5E94\u539F\u7816\u4E0E\u53F2\u6599\u8FA8\u8BA4\uFF0C\u4E0D\u80FD\u4EC5\u51ED\u6E38\u620F\u753B\u9762\u786E\u5B9A\u3002"
    sources: "\u9898\u6750\u4F9D\u636E\uFF1A\u672C\u4F5C\u300A\u5C18\u5C01\u7816\u8BED\u300B\u8BBE\u8BA1\u65B9\u6848\u53CA\u5F00\u9898\u62A5\u544A\u4E2D\u7684\u6CB3\u897F\u9B4F\u664B\u753B\u50CF\u7816\u9009\u9898\u3002\n\n\u5F53\u524D\u5C55\u793A\u4E3A\u6E38\u620F\u590D\u539F\u56FE\u3002\u5BF9\u5E94\u6587\u7269\u7684\u7F16\u53F7\u3001\u6B63\u5F0F\u56FE\u5F55\u9875\u7801\u4E0E\u9986\u85CF\u8D44\u6599\u5C1A\u5F85\u6838\u9A8C\uFF0C\u5177\u4F53\u5E74\u4EE3\u3001\u51FA\u571F\u5730\u548C\u73B0\u85CF\u5730\u4EE5\u6B63\u5F0F\u8D44\u6599\u4E3A\u51C6\u3002"
  - id: yishi
    displayName: "\u9A7F\u4F7F\u56FE"
    sprite: {fileID: 237682790, guid: 37389253860383a4cae4af0ef4670483, type: 3}
    detailSprite: {fileID: 0}
    imageCaption: "\u6E38\u620F\u590D\u539F\u56FE \xB7 \u4F9D\u636E\u753B\u50CF\u7816\u9898\u6750\u6539\u7F16"
    era: "\u9B4F\u664B\u65F6\u671F\uFF08\u9898\u6750\u5E74\u4EE3\uFF09"
    excavationSite: "\u5177\u4F53\u539F\u7816\u51FA\u571F\u4FE1\u606F\u5F85\u8003\u8BC1"
    currentCollection: "\u5F85\u8003\u8BC1"
    interpretation: "\u9A7F\u4F7F\u9898\u6750\u4EE5\u4EBA\u7269\u4E0E\u9A6C\u5339\u7684\u7EC4\u5408\u8868\u73B0\u884C\u65C5\u548C\u4F20\u9012\u6D88\u606F\u7684\u6D3B\u52A8\u3002\u4EBA\u7269\u671D\u5411\u3001\u9A6C\u5339\u59FF\u6001\u4E0E\u7B80\u6D01\u7684\u6784\u56FE\uFF0C\u4F7F\u9759\u6001\u7816\u753B\u4EA7\u751F\u9C9C\u660E\u7684\u884C\u8FDB\u611F\u3002\n\n\u672C\u4F5C\u5C06\u8FD9\u4E00\u9898\u6750\u8F6C\u5316\u4E3A\u4EA4\u901A\u4E0E\u4EA4\u6D41\u7684\u53D9\u4E8B\u3002\u5177\u4F53\u4EBA\u7269\u8EAB\u4EFD\u3001\u9A7F\u4F20\u5236\u5EA6\u53CA\u5E74\u4EE3\uFF0C\u9700\u4F9D\u636E\u5BF9\u5E94\u539F\u7816\u8D44\u6599\u8FDB\u4E00\u6B65\u8BF4\u660E\u3002"
    sources: "\u9898\u6750\u4F9D\u636E\uFF1A\u672C\u4F5C\u300A\u5C18\u5C01\u7816\u8BED\u300B\u8BBE\u8BA1\u65B9\u6848\u53CA\u5F00\u9898\u62A5\u544A\u4E2D\u7684\u6CB3\u897F\u9B4F\u664B\u753B\u50CF\u7816\u9009\u9898\u3002\n\n\u5F53\u524D\u5C55\u793A\u4E3A\u6E38\u620F\u590D\u539F\u56FE\u3002\u5BF9\u5E94\u6587\u7269\u7684\u7F16\u53F7\u3001\u6B63\u5F0F\u56FE\u5F55\u9875\u7801\u4E0E\u9986\u85CF\u8D44\u6599\u5C1A\u5F85\u6838\u9A8C\uFF0C\u5177\u4F53\u5E74\u4EE3\u3001\u51FA\u571F\u5730\u548C\u73B0\u85CF\u5730\u4EE5\u6B63\u5F0F\u8D44\u6599\u4E3A\u51C6\u3002"
  - id: sishen
    displayName: "\u56DB\u795E\u56FE"
    sprite: {fileID: 231636139, guid: 82074c35bc4df00478039f2856ae8dd3, type: 3}
    detailSprite: {fileID: 0}
    imageCaption: "\u6E38\u620F\u590D\u539F\u56FE \xB7 \u4F9D\u636E\u753B\u50CF\u7816\u9898\u6750\u6539\u7F16"
    era: "\u9B4F\u664B\u65F6\u671F\uFF08\u9898\u6750\u5E74\u4EE3\uFF09"
    excavationSite: "\u5177\u4F53\u539F\u7816\u51FA\u571F\u4FE1\u606F\u5F85\u8003\u8BC1"
    currentCollection: "\u5F85\u8003\u8BC1"
    interpretation: "\u56DB\u795E\u9898\u6750\u4EE5\u9752\u9F99\u3001\u767D\u864E\u3001\u6731\u96C0\u3001\u7384\u6B66\u7B49\u4F20\u7EDF\u5F62\u8C61\u8868\u8FBE\u65B9\u4F4D\u89C2\u5FF5\u4E0E\u8C61\u5F81\u610F\u4E49\u3002\u89C2\u770B\u65F6\u53EF\u4EE5\u7559\u610F\u5F62\u4F53\u3001\u59FF\u6001\u53CA\u5F7C\u6B64\u7684\u6392\u5217\u5173\u7CFB\u3002\n\n\u672C\u4F5C\u7684\u753B\u9762\u5C5E\u4E8E\u9898\u6750\u6539\u7F16\uFF0C\u4E0D\u4EE3\u8868\u56DB\u79CD\u5F62\u8C61\u51FA\u81EA\u540C\u4E00\u5757\u5B9E\u7269\u7816\u3002\u5177\u4F53\u56FE\u50CF\u6765\u6E90\u3001\u7EC4\u5408\u65B9\u5F0F\u53CA\u5893\u846C\u8BED\u5883\u9700\u9010\u9879\u8003\u8BC1\u3002"
    sources: "\u9898\u6750\u4F9D\u636E\uFF1A\u672C\u4F5C\u300A\u5C18\u5C01\u7816\u8BED\u300B\u8BBE\u8BA1\u65B9\u6848\u53CA\u5F00\u9898\u62A5\u544A\u4E2D\u7684\u6CB3\u897F\u9B4F\u664B\u753B\u50CF\u7816\u9009\u9898\u3002\n\n\u5F53\u524D\u5C55\u793A\u4E3A\u6E38\u620F\u590D\u539F\u56FE\u3002\u5BF9\u5E94\u6587\u7269\u7684\u7F16\u53F7\u3001\u6B63\u5F0F\u56FE\u5F55\u9875\u7801\u4E0E\u9986\u85CF\u8D44\u6599\u5C1A\u5F85\u6838\u9A8C\uFF0C\u5177\u4F53\u5E74\u4EE3\u3001\u51FA\u571F\u5730\u548C\u73B0\u85CF\u5730\u4EE5\u6B63\u5F0F\u8D44\u6599\u4E3A\u51C6\u3002"
  - id: muzhu
    displayName: "\u5893\u4E3B\u56FE"
    sprite: {fileID: 1818730103, guid: e898ce7e155738849b11e887f860ec5c, type: 3}
    detailSprite: {fileID: 0}
    imageCaption: "\u6E38\u620F\u590D\u539F\u56FE \xB7 \u4F9D\u636E\u753B\u50CF\u7816\u9898\u6750\u6539\u7F16"
    era: "\u9B4F\u664B\u65F6\u671F\uFF08\u9898\u6750\u5E74\u4EE3\uFF09"
    excavationSite: "\u5177\u4F53\u539F\u7816\u51FA\u571F\u4FE1\u606F\u5F85\u8003\u8BC1"
    currentCollection: "\u5F85\u8003\u8BC1"
    interpretation: "\u5893\u4E3B\u751F\u6D3B\u9898\u6750\u5E38\u501F\u4EBA\u7269\u3001\u8F66\u9A6C\u4E0E\u4EEA\u4ED7\u7B49\u5F62\u8C61\u7EC4\u7EC7\u53D9\u4E8B\uFF0C\u5448\u73B0\u5893\u846C\u56FE\u50CF\u4E2D\u7684\u751F\u6D3B\u60F3\u8C61\u3002\u89C2\u770B\u65F6\u53EF\u4EE5\u7559\u610F\u4EBA\u7269\u5927\u5C0F\u3001\u4F4D\u7F6E\u548C\u884C\u8FDB\u65B9\u5411\u5982\u4F55\u5EFA\u7ACB\u753B\u9762\u79E9\u5E8F\u3002\n\n\u672C\u4F5C\u4EE5\u6B64\u8425\u9020\u5DE1\u6E38\u4E0E\u544A\u522B\u7684\u60C5\u5883\u3002\u5177\u4F53\u5893\u4E3B\u8EAB\u4EFD\u3001\u793E\u4F1A\u7B49\u7EA7\u53CA\u4EEA\u5F0F\u542B\u4E49\uFF0C\u4E0D\u80FD\u7531\u6E38\u620F\u6539\u7F16\u56FE\u76F4\u63A5\u63A8\u5B9A\u3002"
    sources: "\u9898\u6750\u4F9D\u636E\uFF1A\u672C\u4F5C\u300A\u5C18\u5C01\u7816\u8BED\u300B\u8BBE\u8BA1\u65B9\u6848\u53CA\u5F00\u9898\u62A5\u544A\u4E2D\u7684\u6CB3\u897F\u9B4F\u664B\u753B\u50CF\u7816\u9009\u9898\u3002\n\n\u5F53\u524D\u5C55\u793A\u4E3A\u6E38\u620F\u590D\u539F\u56FE\u3002\u5BF9\u5E94\u6587\u7269\u7684\u7F16\u53F7\u3001\u6B63\u5F0F\u56FE\u5F55\u9875\u7801\u4E0E\u9986\u85CF\u8D44\u6599\u5C1A\u5F85\u6838\u9A8C\uFF0C\u5177\u4F53\u5E74\u4EE3\u3001\u51FA\u571F\u5730\u548C\u73B0\u85CF\u5730\u4EE5\u6B63\u5F0F\u8D44\u6599\u4E3A\u51C6\u3002"
