  npcName: NPC2
  isCoreNPC: 0
  greetingLines:
  - "\u770B\u4F60\u6A21\u6837\u5E76\u975E\u672C\u5730\u519C\u4EBA\u3002"
  - "\u5982\u4ECA\u6625\u8015\u6B63\u5FD9\uFF0C\u7530\u95F4\u8BF8\u4E8B\u4E00\u56E2\u4E71\uFF0C\u4E0D\u77E5\u4F60\u53EF\u5426\u613F\u610F\u51FA\u624B\u76F8\u52A9\uFF1F"
  taskChoiceText: "\u6211\u613F\u610F\u524D\u6765\u5E2E\u5FD9"
  taskLines:
  - "\u771F\u662F\u592A\u611F\u8C22\u4E86\uFF01\u524D\u51E0\u65E5\u4E00\u9635\u98CE\u6C99\u5439\u8FC7\uFF0C\u4E00\u5934\u8015\u725B\u53D7\u4E86\u60CA\u5413\uFF0C\u8DD1\u8FDB\u4E1C\u4FA7\u7684\u6851\u6797\u91CC\u4E0D\u80AF\u56DE\u6765\u3002"
  - "\u52B3\u70E6\u4F60\u5148\u53BB\u6851\u6797\u628A\u8015\u725B\u5BFB\u56DE\u5427\u3002"
  taskInfo: "\u524D\u5F80\u4E1C\u4FA7\u6851\u6797\uFF0C\u5BFB\u56DE\u53D7\u60CA\u7684\u8015\u725B\u3002"
  scienceChoiceText: "\u8FD9\u7247\u7530\u5730\u6709\u4EC0\u4E48\u6765\u5386\uFF1F"
  scienceLines:
  - "\u8FD9\u91CC\u662F\u6CB3\u897F\u8D70\u5ECA\u4E00\u5E26\u7684\u5C6F\u7530\u519C\u7530\uFF0C\u4E5F\u662F\u9B4F\u664B\u65F6\u671F\u897F\u5317\u5730\u533A\u6700\u4E3B\u8981\u7684\u7CAE\u98DF\u4EA7\u5730\u4E4B\u4E00\u3002"
  - "\u6211\u4EEC\u672C\u5730\u666E\u904D\u4F7F\u7528\u4E8C\u725B\u62AC\u6760\u7684\u8015\u4F5C\u65B9\u5F0F\uFF0C\u4E24\u5934\u8015\u725B\u5408\u529B\u62C9\u7281\uFF0C\u6548\u7387\u8FDC\u8D85\u5355\u4EBA\u72EC\u7281\u3002"
  minorNPCLines:
  - "\u6625\u65E5\u6851\u53F6\u9C9C\u5AE9\uFF0C\u6B63\u662F\u91C7\u6458\u517B\u8695\u7684\u597D\u65F6\u8282\u3002"
  - "\u9B4F\u664B\u65F6\u671F\u4E1D\u7EF8\u8D38\u6613\u5341\u5206\u7E41\u76DB\uFF0C\u6CB3\u897F\u4EA7\u51FA\u7684\u4E1D\u7EF8\u8FDC\u9500\u5404\u5730\u3002"
