  historyId: 92c2c971a308158409dce1814c991616
  npcName: "\u8015\u6C11"
  isCoreNPC: 1
  greetingLines:
  - "\u6625\u8015\u5C06\u8FD1\uFF0C\u4E24\u5934\u725B\u53D7\u4E86\u60CA\uFF0C\u8015\u5177\u4E5F\u9057\u843D\u5728\u7530\u8FB9\u3002"
  - "\u8FD9\u725B\u8BA4\u751F\uFF0C\u8D8A\u8FFD\u8D8A\u8DD1\u3002\u4F60\u53EF\u613F\u610F\u66FF\u6211\u60F3\u4E2A\u6CD5\u5B50\uFF1F"
  taskChoiceText: "\u6211\u53BB\u770B\u770B\u5B83\u4EEC\u7684\u4E60\u6027"
  taskLines:
  - "\u767D\u725B\u548C\u9ED1\u725B\u90FD\u5728\u7530\u8FB9\uFF0C\u5317\u9762\u53EA\u6709\u4E00\u5EA7\u725B\u680F\u3002"
  - "\u8BF7\u5C06\u4E24\u5934\u725B\u8D76\u56DE\u725B\u680F\uFF0C\u518D\u66FF\u6211\u5BFB\u56DE\u9057\u843D\u7684\u8015\u5177\u3002"
  - "\u529E\u59A5\u540E\u56DE\u6765\u627E\u6211\uFF0C\u6211\u4F1A\u5C06\u73CD\u85CF\u7684\u90A3\u5757\u7816\u753B\u6B8B\u7247\u4EA4\u7ED9\u4F60\u3002\u96C6\u9F50\u6B8B\u7247\uFF0C\u624D\u80FD\u590D\u539F\u8FD9\u5E45\u753B\u50CF\u7816\u3002"
  scienceChoiceText: "\u7816\u753B\u4E2D\u7684\u4E24\u5934\u725B\u6709\u4F55\u8BB2\u7A76\uFF1F"
  scienceLines:
  - "\u7816\u753B\u628A\u4E24\u725B\u3001\u7275\u5F15\u7EBF\u4E0E\u8015\u5177\u753B\u5728\u4E00\u8D77\uFF0C\u7559\u4E0B\u4E86\u5F53\u65F6\u519C\u8015\u751F\u6D3B\u7684\u7EBF\u7D22\u3002"
  - "\u770B\u6E05\u56FE\u50CF\u4E2D\u5F7C\u6B64\u7684\u5173\u7CFB\uFF0C\u6BD4\u53EA\u8BA4\u5F97\u4E00\u4EF6\u5668\u7269\u66F4\u6709\u8DA3\u3002\u4F60\u4E0D\u59A8\u4E5F\u5148\u89C2\u5BDF\u725B\u7684\u4E60\u6027\u3002"
  minorNPCLines: []
